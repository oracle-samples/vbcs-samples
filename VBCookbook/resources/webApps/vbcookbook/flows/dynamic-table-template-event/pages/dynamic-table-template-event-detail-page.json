{
  "title": "Link Field Template Detail",
  "description": "",
  "variables": {
    "empId": {
      "type": "any",
      "required": true,
      "onValueChanged": {
        "chains": [
          {
            "chain": "loadEmployeeChain",
            "parameters": {
              "fetchedFields": "[[ $variables.employeeDetailFormRenderedFields ]]",
              "employeeId": "{{ $variables.empId }}"
            }
          }
        ]
      },
      "input": "fromCaller"
    },
    "employee": {
      "type": "getEmployeeResponse"
    },
    "employeeDetailFormLoadingStatus": {
      "type": "string",
      "defaultValue": "pending"
    },
    "employeeDetailFormRenderedFields": {
      "type": "any[]",
      "onValueChanged": {
        "chains": [
          {
            "chain": "loadEmployeeChain",
            "parameters": {
              "fetchedFields": "[[ $variables.employeeDetailFormRenderedFields ]]",
              "employeeId": "{{ $variables.empId }}"
            }
          }
        ]
      }
    }
  },
  "metadata": {
    "businessObjectsGetEmployeeMetadata": {
      "type": "vb/DynamicLayoutMetadataProviderDescriptor",
      "defaultValue": {
        "endpoint": "businessObjects/get_Employee"
      }
    }
  },
  "types": {
    "@decorators.getEmployeeResponse": {
      "endpoint": "get_Employee",
      "service": "businessObjects",
      "path": "response"
    },
    "getEmployeeResponse": "object"
  },
  "eventListeners": {
    "buttonAction": {
      "chains": [
        {
          "chain": "NavigateBackActionChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-dyn-form": {
        "path": "oj-dyn/form/loader"
      }

    }
  }
}
