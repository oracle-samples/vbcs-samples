{
  "title": "Table Add Row Recipe",
  "description": "",
  "variables": {
    "blankRowBuffer": {
      "defaultValue": {
        "jobObject": {
          "items": [
            {
              "jobTitle": ""
            }
          ]
        },
        "job": 0
      },
      "type": "EmployeeType"
    },
    "employeesBDP": {
      "type": "application:ojs/ojbufferingdataprovider",
      "constructorParams": [
        "[[ $page.variables.employeesSDP ]]"
      ]
    },
    "employeesSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "businessObjects/getall_Employee",
        "responseType": "getall_Employee_SDP",
        "itemsPath": "items",
        "keyAttributes": "id",
        "uriParameters": {
          "orderBy": "lastName"
        }
      },
      "required": false,
      "input": "none"
    },
    "isCurrentRowBeingDeleted": {
      "type": "boolean",
      "defaultValue": false
    },
    "jobListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "businessObjects/getall_Job",
        "keyAttributes": "id",
        "itemsPath": "items",
        "responseType": "page:getallJobResponse",
        "transformsContext": {
          "vb-textFilterAttributes": [
            "jobTitle"
          ]
        }
      }
    },
    "currentRowBuffer": {
      "type": "EmployeeType",
      "defaultValue": {
        "jobObject": {
          "items": [
            {
              "jobTitle": ""
            }
          ]
        },
        "job": 0
      }
    },
    "disableRowEditExit": {
      "type": "boolean",
      "defaultValue": false
    },
    "nextIdValue": {
      "type": "number",
      "defaultValue": 10000
    },
    "noChangesToSave": {
      "type": "boolean",
      "defaultValue": true
    },
    "originalRowValues": {
      "type": "any"
    },
    "scrollPosition": {
      "type": "any"
    },
    "editRow": {
      "type": "any",
      "defaultValue": {}
    }
  },
  "metadata": {},
  "types": {
    "EmployeeType": {
      "commissionPct": "number",
      "department": "number",
      "departmentObject": {
        "items": [
          {
            "departmentName": "string"
          }
        ]
      },
      "email": "string",
      "firstName": "string",
      "hireDate": "string",
      "id": "number",
      "job": "number",
      "jobObject": {
        "items": [
          {
            "jobTitle": "string",
            "maxSalary": "number",
            "minSalary": "number"
          }
        ]
      },
      "lastName": "string",
      "manager": "number",
      "phoneNumber": "string",
      "salary": "number"
    },
    "@decorators.EmployeeType": {
      "endpoint": "get_Employee",
      "service": "businessObjects",
      "path": "response"
    },
    "getall_Employee_SDP": {
      "items": [
        {
          "commissionPct": "number",
          "department": "number",
          "departmentObject": {
            "items": [
              {
                "departmentName": "string",
                "id": "number",
                "manager": "number",
                "totalSalary": "number"
              }
            ]
          },
          "email": "string",
          "firstName": "string",
          "hireDate": "string",
          "id": "number",
          "job": "number",
          "jobObject": {
            "items": [
              {
                "id": "number",
                "jobTitle": "string",
                "maxSalary": "number",
                "minSalary": "number"
              }
            ]
          },
          "lastName": "string",
          "manager": "number",
          "phoneNumber": "string",
          "salary": "number"
        }
      ]
    },
    "getallJobResponse": {
      "items": [
        {
          "id": "number",
          "jobTitle": "string"
        }
      ]
    },
    "@decorators.getallJobResponse": {
      "endpoint": "getall_Job",
      "service": "businessObjects",
      "path": "response"
    }
  },
  "chains": {},
  "eventListeners": {
    "tableBeforeRowAddEnd": {
      "chains": [
        {
          "chain": "TableBeforeRowAddEnd",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ],
      "preventDefault": "[[ !$page.functions.isFormValid($event, 'addRow') ]]"
    },
    "buttonAction": {
      "chains": [
        {
          "chain": "SubmitAddRow",
          "parameters": {
            "key": "{{ $current.key }}",
            "index": "{{ $current.index }}",
            "current": "{{ $current }}"
          }
        }
      ]
    },
    "buttonAction2": {
      "chains": [
        {
          "chain": "CancelAddRow",
          "parameters": {
            "key": "{{ $current.key }}",
            "index": "{{ $current.index }}",
            "current": "{{ $current }}"
          }
        }
      ]
    },
    "deleteRowButtonCurrentRowIdOjAction": {
      "chains": [
        {
          "chain": "DeleteRow",
          "parameters": {
            "key": "{{ $current.key }}",
            "row": "{{ $current.row }}"
          }
        }
      ]
    },
    "selectValue": {
      "chains": [
        {
          "chain": "SelectJobValue",
          "parameters": {
            "value": "{{ $event.detail.value }}",
            "previousValue": "{{ $event.detail.previousValue }}",
            "key": "{{ $current.key }}",
            "index": "{{ $current.index }}",
            "current": "{{ $current }}"
          }
        }
      ]
    },
    "ojSelectSingleValue": {
      "chains": [
        {
          "chain": "JobChanged",
          "parameters": {
            "value": "{{ $event.detail.value }}",
            "key": "{{ $current.key }}",
            "index": "{{ $current.index }}",
            "current": "{{ $current }}",
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "tableBeforeRowEdit": {
      "asyncBehavior": "enabled",
      "chains": [
        {
          "chain": "TableBeforeRowEdit",
          "parameters": {
            "rowKey": "{{$event.detail.rowContext.status.rowKey}}",
            "rowIndex": "{{$event.detail.rowContext.status.rowIndex}}",
            "rowData": "{{$event.detail.rowContext.componentElement.getDataForVisibleRow($event.detail.rowContext.status.rowIndex).data}}"
          }
        }
      ]
    },
    "tableBeforeRowEditEnd": {
      "asyncBehavior": "enabled",
      "chains": [
        {
          "chain": "TableBeforeRowEditEnd",
          "parameters": {
            "cancelEdit": "{{$event.detail.cancelEdit}}",
            "rowKey": "{{$event.detail.rowContext.status.rowKey}}",
            "rowIndex": "{{$event.detail.rowContext.status.rowIndex}}",
            "rowData": "{{$event.detail.rowContext.componentElement.getDataForVisibleRow($event.detail.rowContext.status.rowIndex).data}}",
            "event": "{{$event}}",
            "currentRowBuffer": "{{$page.variables.currentRowBuffer}}"
          }
        }
      ],
      "preventDefault": "[[ $page.variables.disableRowEditExit || !$page.functions.isFormValid($event) ]]"
    },
    "ojButtonOjAction2": {
      "chains": [
        {
          "chain": "InsertRow",
          "parameters": {
          }
        }
      ]
    },
    "ojButtonOjAction3": {
      "chains": [
        {
          "chain": "SubmitChanges",
          "parameters": {
          }
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {
          "parameters": {},
          "chain": "AddChangesListener"
        }
      ]
    },
    "WorkaroundVBS28095": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "WorkaroundVBS28095"
        }
      ]
    }

  },
  "imports": {
    "components": {
      "oj-input-number": {
        "path": "ojs/ojinputnumber"
      },
      "oj-label": {
        "path": "ojs/ojlabel"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-text-area": {
        "path": "ojs/ojinputtext"
      },
      "oj-toolbar": {
        "path": "ojs/ojtoolbar"
      }
    },
    "modules": {
      "ojValidationBase": {
        "path": "ojs/ojvalidation-base"
      },
      "ojValidationNumber": {
        "path": "ojs/ojvalidation-number"
      }
    }
  },
  "events": {
    "WorkaroundVBS28095": {
      "payloadType": {
        "record": "object"
      }
    }
  },
  "routerFlow": "recipe"
}