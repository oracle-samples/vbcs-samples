{
  "title": "Single REST Call",
  "description": "",
  "variables": {
    "avatar": {
      "type": {
        "initials": "string",
        "src": "string"
      },
      "defaultValue": {
        "initials": "",
        "src": ""
      }
    },
    "contextualInfoLabelVisible": {
      "type": "boolean",
      "defaultValue": false
    },
    "contextualInfoSticky": {
      "type": "boolean",
      "defaultValue": false
    },
    "dirtyDataFlag": {
      "type": "boolean",
      "defaultValue": false
    },
    "dirtyDialogOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "displayMode": {
      "type": "string"
    },
    "employee": {
      "type": "object"
    },
    "employeeEditFormLoadingStatus": {
      "type": "string",
      "defaultValue": "pending"
    },
    "employeeETag": {
      "type": "string"
    },
    "fetchedEmployee": {
      "type": "object"
    },
    "formState1": {
      "type": "string",
      "defaultValue": ""
    },
    "formState2": {
      "type": "string",
      "defaultValue": ""
    },
    "goToParentOption": {
      "type": "boolean",
      "defaultValue": false
    },
    "isSaved": {
      "type": "boolean",
      "defaultValue": false
    },
    "objectId": {
      "type": "string",
      "defaultValue": ""
    },
    "primaryAlwaysOn": {
      "type": "boolean",
      "defaultValue": true
    },
    "saveOption": {
      "type": "string",
      "defaultValue": "off"
    }

  },
  "metadata": {
    "businessObjectsUpdateEmployeeMetadata": {
      "type": "vb/DynamicLayoutMetadataProviderDescriptor",
      "defaultValue": {
        "endpoint": "businessObjects/update_Employee"
      }
    },
    "dynamicContainerMetadata": {
      "type": "vb/ContainerMetadataProviderDescriptor"
    }

  },
  "types": {},
  "eventListeners": {
    "confirmNoOjAction": {
      "chains": [
        {
          "chain": "dialogResponseChain",
          "parameters": {
            "detail": "{{ $event.detail }}",
            "response": "NO"
          }
        }
      ]
    },
    "confirmYesOjAction": {
      "chains": [
        {
          "chain": "dialogResponseChain",
          "parameters": {
            "detail": "{{ $event.detail }}",
            "response": "YES"
          }
        }
      ]
    },
    "ojSpCancel": {
      "chains": [
        {
          "chain": "spCancelChain",
          "parameters": {
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "ojSpGoToParent": {
      "chains": [
        {
          "chain": "goToParent",
          "parameters": {}
        }
      ]
    },
    "ojSpSubmit": {
      "chains": [
        {
          "chain": "saveEmployeeChain",
          "parameters": {
            "$metadata": "{{ $metadata.businessObjectsUpdateEmployeeMetadata }}",
            "employeeId": "100"
          }
        }
      ]
    },
    "vbBeforeExit": {
      "chains": [
        {
          "chain": "checkBeforeExit",
          "parameters": {}
        }
      ]
    },
    "vbEnter": {
      "chains": [
{
          "chain": "firePageLayoutEventChain"
        },
        {
          "parameters": {
            "$metadata": "{{ $metadata.businessObjectsUpdateEmployeeMetadata }}"
          },
          "chain": "loadEmployeeChain"
        }
      ]
    }

  },
  "imports": {
    "components": {
      "oj-sp-advanced-create-edit": {
        "path": "oj-sp/advanced-create-edit/loader"
      },
      "oj-sp-message-unsaved-changes": {
        "path": "oj-sp/message-unsaved-changes/loader"
      },
      "oj-sp-vertical-anchor-navigator": {
        "path": "oj-sp/vertical-anchor-navigator/loader"
      },
      "oj-dyn-form": {
        "path": "oj-dyn/form/loader"
      }
    }
  },
  "layouts": {
    "containerLayout1": {
      "label": "Container Rule Set 1",
      "layoutType": "container",
      "layouts": {
        "case1": {
          "label": "Case 1",
          "layoutType": "container",
          "layout": {
            "sectionTemplateMap": {
              "template1": "template1",
              "template2": "template2",
              "template3": "template3"
            },
            "displayProperties": [
              "template1",
              "template2",
              "template3"
            ]
          }
        }
      },
      "rules": [
        "containerLayout1-rule1"
      ]
    },
    "containerLayout1-rule1": {
      "expression": "case1"
    }
  },
  "templates": {
    "template1": {
      "title": "Name Section",
      "description": "Name Section",
      "extensible": "byReference",
      "@dt": {
        "type": "section",
        "layout": "containerLayout1"
      },
      "dependencies": [
        "oj-dyn/form/loader",
        "oj-dynamic/form/loader",
        "oj-sp/section/loader",
        "ojs/ojbutton"        ,
        "ojs/ojtoolbar"        ,
        "ojs/ojvalidationgroup"
      ],
      "labelHint": "Name Section"
    },
    "template2": {
      "title": "Contact Details",
      "description": "Contact Details",
      "extensible": "byReference",
      "@dt": {
        "layout": "containerLayout1",
        "type": "section"
      },
      "dependencies": [
        "oj-dyn/form/loader",
        "oj-dynamic/form/loader",
        "oj-sp/section/loader",
        "ojs/ojbutton"        ,
        "ojs/ojtoolbar"        ,
        "ojs/ojvalidationgroup"
      ],
      "labelHint": "Contact Details"
    },
    "template3": {
      "title": "Salary Information",
      "description": "Salary Information",
      "extensible": "byReference",
      "@dt": {
        "layout": "containerLayout1",
        "type": "section"
      },
      "dependencies": [
        "oj-dyn/form/loader",
        "oj-dynamic/form/loader",
        "oj-sp/section/loader",
        "ojs/ojbutton"        ,
        "ojs/ojtoolbar"        ,
        "ojs/ojvalidationgroup"
      ],
      "labelHint": "Salary Information"
    }
  }
}
