{
  "title": "Oracle Visual Builder Cookbook",
  "description": "",
  "variables": {
    "filter": {
      "type": "string",
      "input": "fromUrl"
    },    
    "fullText": {
      "type": "string",
      "input": "fromUrl"
    },
    "showDashboardPanels": {
      "type": "boolean",
      "defaultValue": "[[ ($variables.filter === undefined || $variables.filter === 'all' || !$application.functions.isValidFilter($variables.filter) ) && ($variables.fullText  === null || $variables.fullText  === '' || $variables.fullText === undefined) ]]"
    }

  },
  "metadata": {
  },
  "types": {
  },
  "chains": {},
  "eventListeners": {
    "buttonAction3": {
      "chains": [
        {
          "chain": "ResetSearchActionChain"
        }
      ]
    },
    "hyperlinkClick2": {
      "chains": [
        {
          "chain": "ResetSearchActionChain"
        }
      ]
    },
    "myMenu1MenuAction": {
      "chains": [
        {
          "parameters": {
            "selectedValue": "{{ $event.detail.selectedValue }}"
          },
          "chain": "FilterMenuActionChain"
        }
      ]
    },
    "buttonAction": {
      "chains": [
        {
          "chain": "ScrollRightActionChain"
        }
      ]
    },
    "buttonAction2": {
      "chains": [
        {
          "chain": "ScrollLeftActionChain"
        }
      ]
    },
    "fragmentClicked": {
      "chains": [
        {

          "parameters": {
            "recipe": "{{ $event.detail.recipeId }}"
          },
          "chain": "CardActionChain"
        }
      ]
    },
    "hyperlinkClick": {
      "chains": [
        {
          "parameters": {
            "recipe": "{{ $current.data.id }}"
          },
          "chain": "CardActionChain"
        }
      ]
    },
    "moreApplicationClick": {
      "chains": [
        {
          "parameters": {
            "category": "Application"
          },
          "chain": "OpenCategory"
        }
      ]
    },
    "moreRestClick": {
      "chains": [
        {
          "parameters": {
            "category": "REST"
          },
          "chain": "OpenCategory"
        }
      ]
    },
    "morePWAClick": {
      "chains": [
        {
          "parameters": {
            "category": "PWA"
          },
          "chain": "OpenCategory"
        }
      ]
    },
    "moreDynamicClick": {
      "chains": [
        {
          "parameters": {
            "category": "Dynamic"
          },
          "chain": "OpenCategory"
        }
      ]
    },
    "moreComponentsClick": {
      "chains": [
        {
          "parameters": {
            "category": "Components"
          },
          "chain": "OpenCategory"
        }
      ]
    },
    "ojSpWelcomePageSearch1ValueAction": {
      "chains": [
        {
          "parameters": {
            "value": "{{$event.detail.value}}",
            "itemContext": "{{$event.detail.itemContext}}"
          },
          "chain": "InputSearchValueActionChain"
        }
      ]
    },
    "updateSearchTerm": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "UpdateSearchTerm"
        }
      ]
    }

  },
  "imports": {
    "components": {
      "oj-action-card": {
        "path": "ojs/ojactioncard"
      },
      "oj-avatar": {
        "path": "ojs/ojavatar"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-chart": {
        "path": "ojs/ojchart"
      },
      "oj-chart-item": {
        "path": "ojs/ojchart"
      },
      "oj-combobox-one": {
        "path": "ojs/ojselectcombobox"
      },
      "oj-defer": {
        "path": "ojs/ojdefer"
      },
      "oj-film-strip": {
        "path": "ojs/ojfilmstrip"
      },
      "oj-highlight-text": {
        "path": "ojs/ojhighlighttext"
      },
      "oj-input-search": {
        "path": "ojs/ojinputsearch"
      },
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-list-item-layout": {
        "path": "ojs/ojlistitemlayout"
      },
      "oj-list-view": {
        "path": "ojs/ojlistview"
      },
      "oj-menu": {
        "path": "ojs/ojmenu"
      },
      "oj-menu-button": {
        "path": "ojs/ojbutton"
      },
      "oj-option": {
        "path": "ojs/ojoption"
      },
      "oj-sp-collection-container": {
        "path": "oj-sp/collection-container/loader"
      },
      "oj-sp-welcome-page": {
        "path": "oj-sp/welcome-page/loader"
      }

    },
    "css": []
  },
  "events": {
    "updateSearchTerm": {
      "payloadType": {
        "searchTerm": "string"
      }
    }
  }
}
