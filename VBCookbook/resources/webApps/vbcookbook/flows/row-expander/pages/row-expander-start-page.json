{
  "title": "Table Row Expander Recipe",
  "description": "",
  "variables": {
    "dataSource": {
      "type": "any"
    }
  },
  "metadata": {},
  "types": {
    "@decorators.getall_Employee": {
      "endpoint": "getall_Employee",
      "service": "businessObjects",
      "path": "response"
    },
    "getall_Employee": {
      "items": [
        {
          "firstName": "string",
          "id": "number",
          "job": "number",
          "jobObject": {
            "items": [
              {
                "jobTitle": "string"
              }
            ]
          },
          "lastName": "string",
          "manager": "number",
          "phoneNumber": "string",
          "salary": "number"
        }
      ]
    }
  },
  "chains": {},
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "parameters": {},
          "chain": "fetchEmployees"
        }
      ]
    },
    "anchorClick": {
      "chains": [
        {
          "chain": "callEmployee",
          "parameters": {
            "key": "{{ $current.key }}",
            "index": "{{ $current.index }}",
            "current": "{{ $current }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-accordion": {
        "path": "ojs/ojaccordion"
      },
      "oj-collapsible": {
        "path": "ojs/ojcollapsible"
      },
      "oj-row-expander": {
        "path": "ojs/ojrowexpander"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-rowexpander": {
        "path": "ojs/ojrowexpander"
      },
      "oj-toolbar": {
        "path": "ojs/ojtoolbar"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      }
    }
  }
}