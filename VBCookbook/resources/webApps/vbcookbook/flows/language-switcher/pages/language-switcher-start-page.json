{
  "title": "Language Switcher Recipe",
  "description": "",
  "variables": {
    "employeeListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "businessObjects/getall_Employee",
        "keyAttributes": "id",
        "itemsPath": "items",
        "responseType": "page:getallEmployeeResponse"
      }
    },
    "languageOptions": {
      "type": "object[]",
      "defaultValue": [
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "French"
        }
      ]
    },
    "languageOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $variables.languageOptions }}",
        "keyAttributes": "value",
        "textFilterAttributes": [
          "label"
        ]
      }
    },
    "selectedLocale": {
      "type": "any",
      "defaultValue": "[[ window.localStorage.getItem('vbcs.languageSwitcherApplication.locale') ]]"
    }
  },
  "metadata": {},
  "types": {
    "@decorators.getallEmployeeResponse": {
      "endpoint": "getall_Employee",
      "service": "businessObjects",
      "path": "response"
    },
    "getallEmployeeResponse": {
      "items": [
        {
          "email": "string",
          "firstName": "string",
          "hireDate": "string",
          "id": "number",
          "lastName": "string",
          "phoneNumber": "string",
          "salary": "number"
        }
      ]
    }
  },
  "chains": {},
  "eventListeners": {
    "ojSelectSingleValue": {
      "chains": [
        {
          "chain": "SelectSingleValueChangeChain",
          "parameters": {
            "value": "{{ $event.detail.value }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      }
    }
  },
  "routerFlow": ""
}