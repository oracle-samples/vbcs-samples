{
  "title": "Multi Edit Batch Save Recipe",
  "description": "",
  "variables": {
    "currentEmployee": {
      "type": "employee"
    },
    "departmentId": {
      "type": "number",
      "defaultValue": 8,
      "onValueChanged": {
        "chains": [
          {
            "chain": "FetchDepartment",
            "parameters": {
              "event": "{{ $event }}"
            }
          }
        ]
      }
    },
    "departmentListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "businessObjects/getall_Department",
        "keyAttributes": "id",
        "itemsPath": "items",
        "responseType": "page:getallDepartmentResponse",
        "transformsContext": {
          "vb-textFilterAttributes": [
            "departmentName"
          ]
        }
      }
    },
    "departmentName": {
      "type": "string"
    },
    "employeeListADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "employee"
      }
    },
    "idForNewEmployee": {
      "type": "number",
      "defaultValue": -1
    },
    "rowStatus": {
      "type": "object"
    },
    "originalDepartmentName": {
      "type": "string"
    }
  },
  "types": {
    "@decorators.getallDepartmentResponse": {
      "endpoint": "getall_Department",
      "service": "businessObjects",
      "path": "response"
    },
    "employee": {
      "department": "number",
      "email": "string",
      "firstName": "string",
      "id": "number",
      "lastName": "string",
      "salary": "number"
    },
    "@decorators.employee": {
      "endpoint": "get_Employee",
      "service": "businessObjects",
      "path": "response"
    },
    "getallDepartmentResponse": {
      "items": [
        {
          "departmentName": "string",
          "id": "number"
        }
      ]
    }
  },
  "chains": {},
  "eventListeners": {
    "ojButtonOjAction": {
      "chains": [
        {
          "chain": "UpdateEmployeeChain",
          "parameters": {
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "ojButtonOjAction2": {
      "chains": [
        {
          "chain": "RefreshButtonChain",
          "parameters": {
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "ojButtonOjAction3": {
      "chains": [
        {
          "chain": "NewEmployeeButtonActionChain",
          "parameters": {
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "editEmployee": {
      "chains": [
        {
          "chain": "OpenDialogChain",
          "parameters": {
            "current": "{{ $current.row }}"
          }
        }
      ]
    },
    "deleteEmployee": {
      "chains": [
        {
          "chain": "DeleteEmployee",
          "parameters": {
            "detail": "{{ $event.detail }}",
            "key": "{{ $current.key }}",
            "index": "{{ $current.index }}",
            "current": "{{ $current.row }}"
          }
        }
      ]
    },
    "ojButtonOjAction4": {
      "chains": [
        {
          "chain": "SaveButtonActionChain",
          "parameters": {
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {
          "chain": "FetchDepartment"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-label-value": {
        "path": "ojs/ojlabelvalue"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-dialog": {
        "path": "ojs/ojdialog"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-input-number": {
        "path": "ojs/ojinputnumber"
      },
      "oj-form-layout": {
        "path": "ojs/ojformlayout"
      }

    },
    "modules": {
      "ojValidationBase": {
        "path": "ojs/ojvalidation-base"
      },
      "ojValidationNumber": {
        "path": "ojs/ojvalidation-number"
      }
    }
  }
}