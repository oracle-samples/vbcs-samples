{
  "title": "List View Form",
  "description": "",
  "variables": {

    "employeeListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {

        "keyAttributes": "id",
        "itemsPath": "items",
        "responseType": "getallEmployeeResponse",
        "fetchChain": "getall_EmployeeFetch"
      }
    },
    "path": {
      "type": {
        "applicationPath": "string"
      },
      "defaultValue": {
        "applicationPath": "[[$application.path]]"
      }
    }
  },
  "metadata": {
    "businessObjectsGetEmployeeMetadata": {
      "type": "vb/DynamicLayoutMetadataProviderDescriptor",
      "defaultValue": {
        "endpoint": "businessObjects/get_Employee"
      }
    }
  },
  "types": {
    "@decorators.getallEmployeeResponse": {
      "endpoint": "getall_Employee",
      "service": "businessObjects",
      "path": "response"
    },
    "getallEmployeeResponse": {
      "items": [
        {
          "email": "string",
          "firstName": "string",
          "hireDate": "string",
          "id": "number",
          "lastName": "string",
          "phoneNumber": "string",
          "salary": "number"
        }
      ]
    }
  },
  "chains": {},
  "eventListeners": {},
  "imports": {
    "components": {
      "oj-dyn-form": {
        "path": "oj-dyn/form/loader"
      },
      "oj-list-item-layout": {
        "path": "ojs/ojlistitemlayout"
      },
      "oj-list-view": {
        "path": "ojs/ojlistview"
      }

    }
  }
}