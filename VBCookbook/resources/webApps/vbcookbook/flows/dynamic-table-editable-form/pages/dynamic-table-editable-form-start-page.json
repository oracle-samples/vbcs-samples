{
  "title": "Editable Table",
  "description": "",
  "variables": {
    "employeeListSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "businessObjects/getall_Employee",
        "keyAttributes": "id",
        "itemsPath": "items",
        "responseType": "getallEmployeeResponse"
      }
    },
    "employeesCustomBDP": {
      "type": "application:ojs/ojbufferingdataprovider",
      "constructorParams": [
        "[[ $variables.employeeListSDP ]]",
        null
      ]
    }
  },
  "metadata": {
    "businessObjectsGetallEmployeeMetadata": {
      "type": "vb/DynamicLayoutMetadataProviderDescriptor",
      "defaultValue": {
        "endpoint": "businessObjects/update_Employee"
      }
    }
  },
  "types": {
    "@decorators.getallEmployeeResponse": {
      "endpoint": "getall_Employee",
      "service": "businessObjects",
      "path": "response"
    },
    "getallEmployeeResponse": {
      "items": "object[]"
    }
  },
  "eventListeners": {
    "buttonAction": {
      "chains": [
        {
          "chain": "saveActionChain"
        }
      ]
    },
    "buttonAction2": {
      "chains": [
        {
          "parameters": {},
          "chain": "resetActionChain"
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {
          "parameters": {},
          "chain": "assignListeners"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-dynamic-table": {
        "path": "oj-dynamic/table/loader"
      },
      "oj-label": {
        "path": "ojs/ojlabel"
      },
      "oj-text-area": {
        "path": "ojs/ojinputtext"
      }
    }
  }
}